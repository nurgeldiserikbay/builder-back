import { chromium } from 'playwright-core';
import { readFileSync } from 'node:fs';
const pid = readFileSync('/tmp/pid8', 'utf8').trim();
const value = readFileSync('/tmp/cj', 'utf8').trim().split('\t').pop()!;
const browser = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1243/chrome-linux64/chrome' });
const context = await browser.newContext({ viewport: { width: 390, height: 844 }, locale: 'ru-RU', deviceScaleFactor: 2 });
await context.addCookies([{ name: 'buildpath_session', value, domain: 'localhost', path: '/api/v1', httpOnly: true }]);
const page = await context.newPage();
const errors: string[] = [];
page.on('pageerror', (e) => errors.push(String(e)));
await page.goto(`http://localhost:3000/projects/${pid}/stages/launch`, { waitUntil: 'networkidle' });
await page.locator('#platform-title').scrollIntoViewIfNeeded();
await page.screenshot({ path: '/tmp/l1.png' });
await page.getByRole('button', { name: 'Готово' }).nth(3).click();
await page.getByRole('button', { name: 'Не нужно' }).first().click();
await page.getByLabel('Почему не нужно').first().fill('Пока адрес хостинга');
await page.getByRole('button', { name: 'Сохранить', exact: true }).click();
await page.waitForTimeout(1500);
await page.locator('#items-title').scrollIntoViewIfNeeded();
await page.screenshot({ path: '/tmp/l2.png' });
await page.goto(`http://localhost:3000/projects/${pid}`, { waitUntil: 'networkidle' });
await page.getByText('Запуск', { exact: true }).first().scrollIntoViewIfNeeded().catch(() => {});
await page.screenshot({ path: '/tmp/l3.png' });
console.log('scrollWidth', await page.evaluate(() => document.documentElement.scrollWidth), errors);
await browser.close();
