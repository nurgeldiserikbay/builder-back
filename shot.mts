import { chromium } from 'playwright-core';
import { readFileSync } from 'node:fs';
const pid = readFileSync('/tmp/pid7', 'utf8').trim();
const value = readFileSync('/tmp/cj', 'utf8').trim().split('\t').pop()!;
const browser = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1243/chrome-linux64/chrome' });
const context = await browser.newContext({ viewport: { width: 390, height: 844 }, locale: 'ru-RU', deviceScaleFactor: 2 });
await context.addCookies([{ name: 'buildpath_session', value, domain: 'localhost', path: '/api/v1', httpOnly: true }]);
const page = await context.newPage();
const errors: string[] = [];
page.on('pageerror', (e) => errors.push(String(e)));
await page.goto(`http://localhost:3000/projects/${pid}/stages/testplan`, { waitUntil: 'networkidle' });
await page.locator('#accept-title').scrollIntoViewIfNeeded();
const first = page.locator('#accept-title ~ article button[aria-expanded]').first();
await first.click();
await page.getByRole('button', { name: 'Работает, есть замечание' }).click();
await page.waitForTimeout(600);
console.log('refused:', await page.getByText('хотя бы 10 символов').count());
await page.getByLabel('Что не так или что поправить (для «Не работает» и замечания)').fill('Кнопка сохранения прячется под клавиатурой');
await page.getByRole('button', { name: 'Работает, есть замечание' }).click();
await page.waitForTimeout(1000);
await page.locator('#ready-title').scrollIntoViewIfNeeded();
await page.screenshot({ path: '/tmp/a1.png' });
await page.goto(`http://localhost:3000/projects/${pid}/stages/roadmap`, { waitUntil: 'networkidle' });
const remark = page.getByText('замечание владельца').first();
await remark.scrollIntoViewIfNeeded();
await page.screenshot({ path: '/tmp/a2.png' });
console.log('scrollWidth', await page.evaluate(() => document.documentElement.scrollWidth), errors);
await browser.close();
