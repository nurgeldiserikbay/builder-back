{
  "name": "@buildpath/api",
  "version": "0.1.0",
  "private": true,
  "description": "BuildPath REST API",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.build.json && node scripts/build-export.mjs",
    "start": "node dist/main.js",
    "start:migrate": "prisma migrate deploy && node dist/main.js",
    "start:dev": "npm run db:generate && node scripts/dev.mjs main",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "npm run db:generate && node scripts/dev.mjs worker",
    "staff:create": "tsx scripts/create-staff-account.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "start:sites": "node dist/sites.js",
    "start:sites:dev": "npm run db:generate && node scripts/dev.mjs sites",
    "build:export": "node scripts/build-export.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-presigned-post": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^10.78.0",
    "chrome-launcher": "^1.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.2.3",
    "lighthouse": "^13.6.0",
    "parse5": "^8.1.1",
    "pg": "^8.16.3",
    "playwright-core": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  },
  "type": "module"
}
