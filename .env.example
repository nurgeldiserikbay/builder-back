NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://buildpath:buildpath@localhost:5432/buildpath?schema=public
RESEND_API_KEY=
EMAIL_FROM=BuildPath <noreply@example.com>
# Optional: another Resend-compatible API address (local mock for tests)
RESEND_API_URL=
# off — booking forms do not offer e-mail reminders even when mail is configured
BOOKING_EMAIL_REMINDERS=on
PUBLIC_APP_URL=http://localhost:3000

# Private design asset object storage (required for PNG/JPEG design uploads)
DESIGN_ASSETS_BUCKET=buildpath-designs
DESIGN_ASSETS_REGION=us-east-1
DESIGN_ASSETS_ENDPOINT=http://localhost:9000
DESIGN_ASSETS_PATH_STYLE=true
DESIGN_ASSETS_ACCESS_KEY=buildpath
DESIGN_ASSETS_SECRET_KEY=buildpathsecret
# ClamAV daemon reachable from the API; uploads stay pending if it is unavailable
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Photo uploads are scanned by ClamAV and rejected (503) when it is unreachable. Local development only:
# UPLOAD_MALWARE_SCAN=disabled skips the scan; it is ignored when NODE_ENV=production.
UPLOAD_MALWARE_SCAN=

# Headless browser path for page capture jobs; install Chromium and run the worker as a non-root user
CAPTURE_CHROMIUM_EXECUTABLE_PATH=

# Figma OAuth app (redirect URI must point to /integrations/figma/callback on the frontend)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/integrations/figma/callback
# Base64-encoded 32-byte key used to encrypt Figma OAuth tokens at rest
FIGMA_TOKEN_ENCRYPTION_KEY=

# Optional on-demand visual analysis; invoked explicitly from the review workspace
AI_REVIEW_OPENAI_API_KEY=
AI_REVIEW_OPENAI_MODEL=

# Initial staff provisioning (only used by npm run staff:create; set explicitly)
STAFF_INITIAL_EMAIL=
STAFF_INITIAL_PASSWORD=
STAFF_INITIAL_DISPLAY_NAME=
STAFF_INITIAL_ROLE=super_admin

# Stage AI agent (optional). Without it the journey still works: forms, manual edits, template drafts for texts and style,
# deterministic site build. Each generation may incur provider charges.
BUILDER_AI_OPENAI_API_KEY=
BUILDER_AI_OPENAI_MODEL=
# Optional OpenAI-compatible Responses endpoint; https only (http allowed for localhost in development)
BUILDER_AI_OPENAI_BASE_URL=
# Voice messages in the Telegram bot (optional): speech recognition model at the same provider, e.g. whisper-1.
# Off when empty. Each person allows it in the bot before the first recording is sent; up to 30 a day, 2 minutes each.
BUILDER_AI_TRANSCRIBE_MODEL=
# Generations per project per 24 hours (template drafts are not counted)
BUILDER_AI_DAILY_RUNS_PER_PROJECT=40

# Published sites server (npm run start:sites). Each site is served at <slug>.<SITES_BASE_DOMAIN>.
# Production: wildcard DNS *.SITES_BASE_DOMAIN and a wildcard TLS certificate in front of this process.
SITES_BASE_DOMAIN=localhost
SITES_PORT=4100
# Link shown to owners; {slug} is replaced. Example: https://{slug}.buildpath.site
SITES_PUBLIC_URL_TEMPLATE=http://{slug}.localhost:4100
# true only behind a trusted reverse proxy that sets X-Forwarded-For
SITES_TRUST_PROXY=false
# Secret salt for hashing visitor IPs used in lead rate limits (set a long random value)
SITES_IP_HASH_SALT=
# Signs form tokens on published sites (spam protection). Optional: SITES_IP_HASH_SALT is used when empty.
# Without a fixed value, a restart makes open pages ask visitors to reload before sending a form.
SITES_FORM_SECRET=
# Own domains for published sites (choice card «Адрес сайта»). Leave both empty to hide the option.
# Owners point www.<domain> with CNAME to SITES_CNAME_TARGET and the bare domain with A records to SITES_PUBLIC_IPV4.
SITES_CNAME_TARGET=
# Comma-separated public IPv4 addresses of the server in front of the sites process
SITES_PUBLIC_IPV4=
# true only if the sites servers are physically in Kazakhstan: .kz/.қаз domains must be hosted there
SITES_HOSTED_IN_KZ=false
# Optional resolvers for the DNS check, e.g. 1.1.1.1,8.8.8.8 (default: the host's resolver)
SITES_DNS_SERVERS=
# Leads are deleted automatically after this many days
LEAD_RETENTION_DAYS=365

# Telegram bot for lead notifications (optional). Register the webhook with:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/v1/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional Bot API base URL (https; http only for a local mock)
TELEGRAM_API_BASE_URL=

# Plans: limits live in src/billing/plans.ts; prices and the upgrade contact are set in the admin console.
# Fallback upgrade contact until one is set in the console (https:// or mailto:).
SALES_CONTACT_URL=

# true only behind a trusted reverse proxy (production: Caddy) so the API sees the client address
TRUST_PROXY=false
# Optional error reporting (Sentry or self-hosted GlitchTip). Events carry no cookies, bodies, query strings or user data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_RELEASE=

# Legal documents (offer and privacy policy): company details shown in the published texts.
# Unset values appear as "[будет указано]" — fill them in before opening registration.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_BIN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_BANK=
LEGAL_SUPPORT_EMAIL=
# Defaults to LEGAL_SUPPORT_EMAIL.
LEGAL_PRIVACY_EMAIL=
# Hosting provider and city, e.g. "PS Cloud, Алматы".
LEGAL_HOSTING_PROVIDER=
# Where backups are kept, e.g. "на том же сервере и в хранилище PS Cloud (Алматы)".
LEGAL_BACKUP_STORAGE=
# Hourly purge of deleted accounts after the retention period (set in the admin console). true disables it.
ACCOUNT_PURGE_DISABLED=false

# Code hosting (choice card «Где хранить код»): 32-byte key, base64, to encrypt repository access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Without it, connecting GitHub/GitLab is unavailable; the archive works.
# Also encrypts specialists' payout IBANs. Generate: openssl rand -base64 32
CODE_HOSTING_TOKEN_ENCRYPTION_KEY=
# «Войти через GitHub» (OAuth App). Create one at https://github.com/settings/developers → «New OAuth App»;
# Authorization callback URL: <PUBLIC_API_URL>/api/v1/oauth/github/callback. Leave empty to offer only pasted keys.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public address of this API (used for the OAuth callback), e.g. https://api.buildpath.kz
PUBLIC_API_URL=
# Local mocks only: GITHUB_WEB_URL=http://localhost:4557 and GITHUB_API_URL=http://localhost:4557/api/v3
# Development only: allow http://localhost repository addresses (local mocks).
CODE_HOSTING_ALLOW_LOCAL=false

# Payments for project balance top-ups. Freedom Pay (Kazakhstan): merchant id and secret key from the merchant cabinet;
# result URL is <PUBLIC_API_URL>/api/v1/payments/freedompay/result. FREEDOMPAY_TESTING_MODE=false only for live payments.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_API_URL=https://api.freedompay.kz
FREEDOMPAY_TESTING_MODE=true
# PAYMENTS_PROVIDER=mock gives a local test payment page (never in production).
PAYMENTS_PROVIDER=

# Reminders and owner escalation for late answers to change notices (every 15 minutes).
CHANGE_REMINDERS_DISABLED=false
# Hourly reminder to the side of a dispute that has not answered for 3 days (true to switch off, e.g. in tests).
DISPUTE_REMINDERS_DISABLED=false

# Page view counts of published sites (no cookies, no IP addresses). off to switch off; day boundaries in this time zone.
SITES_VISIT_COUNTS=on
SITES_STATS_TIMEZONE=Asia/Almaty
# Availability checks of live sites every 10 minutes and the Monday report (true to switch off, e.g. in tests).
SITE_MONITORING_DISABLED=false
