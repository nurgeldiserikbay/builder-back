NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://buildpath:buildpath@localhost:5432/buildpath?schema=public
RESEND_API_KEY=
EMAIL_FROM=BuildPath <noreply@example.com>
PUBLIC_APP_URL=http://localhost:3000

# Private design asset object storage (required for PNG/JPEG design uploads)
DESIGN_ASSETS_BUCKET=buildpath-designs
DESIGN_ASSETS_REGION=us-east-1
DESIGN_ASSETS_ENDPOINT=http://localhost:9000
DESIGN_ASSETS_PATH_STYLE=true
DESIGN_ASSETS_ACCESS_KEY=buildpath
DESIGN_ASSETS_SECRET_KEY=buildpathsecret
# ClamAV daemon reachable from the API; uploads stay pending if it is unavailable
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Photo uploads are scanned by ClamAV and rejected (503) when it is unreachable. Local development only:
# UPLOAD_MALWARE_SCAN=disabled skips the scan; it is ignored when NODE_ENV=production.
UPLOAD_MALWARE_SCAN=

# Headless browser path for page capture jobs; install Chromium and run the worker as a non-root user
CAPTURE_CHROMIUM_EXECUTABLE_PATH=

# Figma OAuth app (redirect URI must point to /integrations/figma/callback on the frontend)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/integrations/figma/callback
# Base64-encoded 32-byte key used to encrypt Figma OAuth tokens at rest
FIGMA_TOKEN_ENCRYPTION_KEY=

# Optional on-demand visual analysis; invoked explicitly from the review workspace
AI_REVIEW_OPENAI_API_KEY=
AI_REVIEW_OPENAI_MODEL=

# Initial staff provisioning (only used by npm run staff:create; set explicitly)
STAFF_INITIAL_EMAIL=
STAFF_INITIAL_PASSWORD=
STAFF_INITIAL_DISPLAY_NAME=
STAFF_INITIAL_ROLE=super_admin

# Stage AI agent (optional). Without it the journey still works: forms, manual edits, template drafts for texts and style,
# deterministic site build. Each generation may incur provider charges.
BUILDER_AI_OPENAI_API_KEY=
BUILDER_AI_OPENAI_MODEL=
# Optional OpenAI-compatible Responses endpoint; https only (http allowed for localhost in development)
BUILDER_AI_OPENAI_BASE_URL=
# Generations per project per 24 hours (template drafts are not counted)
BUILDER_AI_DAILY_RUNS_PER_PROJECT=40

# Published sites server (npm run start:sites). Each site is served at <slug>.<SITES_BASE_DOMAIN>.
# Production: wildcard DNS *.SITES_BASE_DOMAIN and a wildcard TLS certificate in front of this process.
SITES_BASE_DOMAIN=localhost
SITES_PORT=4100
# Link shown to owners; {slug} is replaced. Example: https://{slug}.buildpath.site
SITES_PUBLIC_URL_TEMPLATE=http://{slug}.localhost:4100
# true only behind a trusted reverse proxy that sets X-Forwarded-For
SITES_TRUST_PROXY=false
# Secret salt for hashing visitor IPs used in lead rate limits (set a long random value)
SITES_IP_HASH_SALT=
# Leads are deleted automatically after this many days
LEAD_RETENTION_DAYS=365

# Telegram bot for lead notifications (optional). Register the webhook with:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/v1/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional Bot API base URL (https; http only for a local mock)
TELEGRAM_API_BASE_URL=

# Plans (src/billing/plans.ts holds the limits). Display prices; leave empty to show "Цена по запросу".
PLAN_PRICE_START=
PLAN_PRICE_BUSINESS=
# Where customers ask to upgrade until online payment exists (https://, mailto: or tg://)
SALES_CONTACT_URL=
