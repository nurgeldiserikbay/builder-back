NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://buildpath:buildpath@localhost:5432/buildpath?schema=public
RESEND_API_KEY=
EMAIL_FROM=BuildPath <noreply@example.com>
PUBLIC_APP_URL=http://localhost:3000

# Private design asset object storage (required for PNG/JPEG design uploads)
DESIGN_ASSETS_BUCKET=buildpath-designs
DESIGN_ASSETS_REGION=us-east-1
DESIGN_ASSETS_ENDPOINT=http://localhost:9000
DESIGN_ASSETS_PATH_STYLE=true
DESIGN_ASSETS_ACCESS_KEY=buildpath
DESIGN_ASSETS_SECRET_KEY=buildpathsecret
# ClamAV daemon reachable from the API; uploads stay pending if it is unavailable
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
