# Reverse proxy and automatic HTTPS (Let's Encrypt).
# APP_HOST   — the app for customers; /api/* goes to the API on the same origin (no CORS, first-party cookies).
# ADMIN_HOST — the staff console; /api/* goes to the same API.
# Every other host is a published customer site. Certificates for them are issued on demand, but only after
# the sites server confirms the host is a live site (/__caddy/ask), so nobody can make us request arbitrary certificates.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://sites:4100/__caddy/ask
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$APP_HOST} {
	encode zstd gzip
	import common_headers
	# The app also opens as a Telegram Mini App, which Telegram Web shows in a frame.
	header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy front:3000
	}
}

{$ADMIN_HOST} {
	encode zstd gzip
	import common_headers
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Robots-Tag "noindex, nofollow"
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy admin:3000
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy sites:4100
}
