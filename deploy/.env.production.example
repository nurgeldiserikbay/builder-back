# Copy to .env.production on the server and fill in. Never commit .env.production.
# Generate secrets with: openssl rand -hex 32

# --- Addresses -------------------------------------------------------------------------------
# App for customers (the API is served on the same host under /api).
APP_HOST=buildpath.kz
# Staff console.
ADMIN_HOST=admin.buildpath.kz
# Published sites open at <slug>.<SITES_BASE_DOMAIN>. DNS: wildcard A record *.sites.buildpath.kz -> server IP.
SITES_BASE_DOMAIN=sites.buildpath.kz
SITES_PUBLIC_URL_TEMPLATE=https://{slug}.sites.buildpath.kz
# Own domains: owners point www.<domain> (CNAME) to this name and the bare domain (A) to the server IP.
SITES_CNAME_TARGET=sites.buildpath.kz
SITES_PUBLIC_IPV4=
# true only if this server is physically in Kazakhstan (required for .kz/.қаз domains)
SITES_HOSTED_IN_KZ=false
SITES_DNS_SERVERS=1.1.1.1,8.8.8.8
# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=admin@buildpath.kz
PUBLIC_APP_URL=https://buildpath.kz

# --- Runtime (keep as is) --------------------------------------------------------------------
NODE_ENV=production
PORT=4000
SITES_PORT=4100
TRUST_PROXY=true
SITES_TRUST_PROXY=true
# Same-origin API, so CORS is not needed. List origins only if another site must call the API.
CORS_ORIGINS=

# --- Database --------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://buildpath:CHANGE_ME@postgres:5432/buildpath?schema=public

# --- Security ----------------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Must stay empty in production (photo uploads are rejected while ClamAV is unavailable).
UPLOAD_MALWARE_SCAN=
SITES_IP_HASH_SALT=
LEAD_RETENTION_DAYS=365

# --- E-mail (Resend) -------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=BuildPath <noreply@buildpath.kz>

# --- AI for stages (OpenAI; each generation is billed by the provider) --------------------------
BUILDER_AI_OPENAI_API_KEY=
BUILDER_AI_OPENAI_MODEL=
BUILDER_AI_OPENAI_BASE_URL=
BUILDER_AI_DAILY_RUNS_PER_PROJECT=40

# --- Telegram ----------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Plans -------------------------------------------------------------------------------------
# Prices and the upgrade contact are set in the staff console; this is only a fallback contact.
SALES_CONTACT_URL=

# --- Error monitoring (optional; Sentry or self-hosted GlitchTip) --------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Browser errors of the app and console; baked into the images at build time (rebuild after changing).
NEXT_PUBLIC_SENTRY_DSN=
# Set to the git commit or a date to tag images and error reports.
APP_RELEASE=

# --- Backups -----------------------------------------------------------------------------------
# Daily at 02:30 server time (UTC in the container unless TZ is set); local copies in deploy/backups.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP_DAYS=14
TZ=Asia/Almaty
# Off-site copy through rclone (recommended; S3-compatible storage, preferably in Kazakhstan). Leave empty to keep only local copies.
BACKUP_REMOTE=
# Example for S3-compatible storage; BACKUP_REMOTE=offsite:bucket-name/postgres
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Off-site copies are encrypted with this passphrase (AES-256). Store it separately: without it backups cannot be restored.
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Design review tool (optional, --profile design-review) --------------------------------------
DESIGN_ASSETS_BUCKET=buildpath-designs
DESIGN_ASSETS_REGION=us-east-1
DESIGN_ASSETS_ENDPOINT=http://minio:9000
DESIGN_ASSETS_PATH_STYLE=true
DESIGN_ASSETS_ACCESS_KEY=
DESIGN_ASSETS_SECRET_KEY=

# Legal documents (offer and privacy policy): company details shown in the published texts.
# Unset values appear as "[будет указано]" — fill them in before opening registration.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_BIN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_BANK=
LEGAL_SUPPORT_EMAIL=
# Defaults to LEGAL_SUPPORT_EMAIL.
LEGAL_PRIVACY_EMAIL=
# Hosting provider and city, e.g. "PS Cloud, Алматы".
LEGAL_HOSTING_PROVIDER=
# Where backups are kept, e.g. "на том же сервере и в хранилище PS Cloud (Алматы)".
LEGAL_BACKUP_STORAGE=
# Hourly purge of deleted accounts after the retention period (set in the admin console). true disables it.
ACCOUNT_PURGE_DISABLED=false

# Code hosting (choice card «Где хранить код»): 32-byte key, base64, to encrypt repository access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Without it, connecting GitHub/GitLab is unavailable; the archive works.
CODE_HOSTING_TOKEN_ENCRYPTION_KEY=
