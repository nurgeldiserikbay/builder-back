  payoutTiyn     Int?            @map("payout_tiyn")
  provider       String?         @db.VarChar(20)
  providerPaymentId String?      @map("provider_payment_id") @db.VarChar(64)
  heldAt         DateTime?       @map("held_at") @db.Timestamptz(3)
  paidOutAt      DateTime?       @map("paid_out_at") @db.Timestamptz(3)
  payoutReference String?        @map("payout_reference") @db.VarChar(100)
  refundedAt     DateTime?       @map("refunded_at") @db.Timestamptz(3)
  refundReference String?        @map("refund_reference") @db.VarChar(100)
  refundNote     String?         @map("refund_note") @db.VarChar(300)
  paidOutByStaffId String?       @map("paid_out_by_staff_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  assignment     StageAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([projectId, status], map: "stage_payments_project_status_idx")
  @@map("stage_payments")
}

/// A client's booking made on a published site of the online booking route. Overlaps per master are prevented in a locked transaction.
model Booking {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  publicationId  String          @map("publication_id") @db.Uuid
  serviceName    String          @map("service_name") @db.VarChar(80)
  minutes        Int
  price          String?         @db.VarChar(40)
  masterKey      String          @map("master_key") @db.VarChar(12)
  masterName     String          @map("master_name") @db.VarChar(60)
  startsAt       DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime        @map("ends_at") @db.Timestamptz(3)
  timezone       String          @db.VarChar(40)
  clientName     String          @map("client_name") @db.VarChar(80)
  clientPhone    String          @map("client_phone") @db.VarChar(30)
  comment        String?         @db.VarChar(300)
  /// Only for the reminder; erased once the reminder is sent, failed or no longer needed.
  clientEmail    String?         @map("client_email") @db.VarChar(254)
  /// When the e-mail reminder is due; null when there is none.
  reminderAt     DateTime?       @map("reminder_at") @db.Timestamptz(3)
  /// pending | sending | sent | failed | skipped
  reminderStatus String?         @map("reminder_status") @db.VarChar(10)
  /// The cancel link token sealed with the platform key, so the reminder can carry the link; erased with the e-mail.
  cancelLinkSealed String?       @map("cancel_link_sealed") @db.Text
  /// booked | cancelled_by_client | cancelled_by_owner | done | no_show
  status         String          @default("booked") @db.VarChar(20)
  /// SHA-256 of the client's cancel link token; the token itself is only in the link.
  tokenHash      String          @unique(map: "bookings_token_hash_key") @map("token_hash") @db.VarChar(64)
  consentAt      DateTime        @map("consent_at") @db.Timestamptz(3)
  ipHash         String          @map("ip_hash") @db.VarChar(64)
  telegramStatus String          @default("pending") @map("telegram_status") @db.VarChar(20)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publication    SitePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, masterKey, startsAt], map: "bookings_publication_master_start_idx")
  @@index([projectId, startsAt], map: "bookings_project_start_idx")
  @@index([reminderStatus, reminderAt], map: "bookings_reminder_due_idx")
  @@map("bookings")
}

/// A person's connected account at a code host (GitHub OAuth). The token is encrypted with CODE_HOSTING_TOKEN_ENCRYPTION_KEY and never returned.
model GitAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
