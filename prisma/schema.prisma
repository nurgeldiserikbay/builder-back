enum ChangeNoticeStatus {
  open
  discussing
  accepted
  accepted_no_change
  superseded
}

/// A new accepted version of a stage, waiting for the decision of a stage built on it. While open, the target
/// stage keeps using previousVersionId of the source (pinned input).
model ChangeNotice {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  sourceStageId     String             @map("source_stage_id") @db.Uuid
  targetStageId     String             @map("target_stage_id") @db.Uuid
  previousVersionId String             @map("previous_version_id") @db.Uuid
  newVersionId      String             @map("new_version_id") @db.Uuid
  changes           String[]           @default([])
  status            ChangeNoticeStatus @default(open)
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  decidedByOwner    Boolean            @default(false) @map("decided_by_owner")
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  /// The target side is asked to decide by this time; then reminded once, and two days later the owner is asked to decide.
  respondBy         DateTime?          @map("respond_by") @db.Timestamptz(3)
  remindedAt        DateTime?          @map("reminded_at") @db.Timestamptz(3)
  escalatedAt       DateTime?          @map("escalated_at") @db.Timestamptz(3)
  /// On-demand AI explanation for the target side (untrusted text, validated shape); never a decision.
  aiExplanation     Json?              @map("ai_explanation")
  aiExplainedAt     DateTime?          @map("ai_explained_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceStage       ProjectStage       @relation("ChangeNoticeSource", fields: [sourceStageId], references: [id], onDelete: Cascade)
  targetStage       ProjectStage       @relation("ChangeNoticeTarget", fields: [targetStageId], references: [id], onDelete: Cascade)
  messages          ChangeMessage[]

  @@index([projectId, status], map: "change_notices_project_status_idx")
  @@index([targetStageId, status], map: "change_notices_target_status_idx")
  @@index([status, respondBy], map: "change_notices_status_respond_idx")
  @@index([sourceStageId, status], map: "change_notices_source_status_idx")
  @@map("change_notices")
}

/// Discussion between the stage that changed (source side) and the stage built on it (target side).
model ChangeMessage {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId     String       @map("notice_id") @db.Uuid
  authorUserId String       @map("author_user_id") @db.Uuid
  side         String       @db.VarChar(10)
  resolution   String?      @db.VarChar(20)
  text         String       @db.VarChar(2000)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  notice       ChangeNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, createdAt], map: "change_messages_notice_created_idx")
  @@map("change_messages")
}

/// A decision made with a choice card (where to keep the code, where to deploy...). One row per card; history in project events.
model ProjectChoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  cardKey        String   @map("card_key") @db.VarChar(40)
  cardVersion    String   @map("card_version") @db.VarChar(20)
  optionKey      String   @map("option_key") @db.VarChar(40)
  reason         String?  @db.VarChar(500)
  stepsDone      String[] @default([]) @map("steps_done") @db.VarChar(40)
  /// Last automatic check of the result (for deployment: address, outcome, time).
  verification   Json?
  chosenByUserId String   @map("chosen_by_user_id") @db.Uuid
  chosenAt       DateTime @default(now()) @map("chosen_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, cardKey], map: "project_choices_project_card_key")
  @@map("project_choices")
}

/// Repository connected to a project. The access token is encrypted (AES-256-GCM) and never returned by the API.
model CodeRepository {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String    @unique @map("project_id") @db.Uuid
  provider         String    @db.VarChar(20)
  baseUrl          String    @map("base_url") @db.VarChar(300)
  repoPath         String    @map("repo_path") @db.VarChar(200)
  webUrl           String    @map("web_url") @db.VarChar(500)
  defaultBranch    String    @map("default_branch") @db.VarChar(120)
  isPrivate        Boolean   @map("is_private")
  tokenEncrypted   String    @map("token_encrypted")
  /// token (pasted access token) | oauth (connected GitHub account)
  connectedVia   String   @default("token") @map("connected_via") @db.VarChar(10)
  tokenHint        String    @map("token_hint") @db.VarChar(8)
  connectedByUserId String   @map("connected_by_user_id") @db.Uuid
  verifiedAt       DateTime  @map("verified_at") @db.Timestamptz(3)
