  @@index([assignmentId, startedAt(sort: Desc)], map: "time_entries_assignment_started_idx")
  @@map("time_entries")
}

/// Money due to a specialist when the owner accepts the stage.
model StagePayment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId   String          @map("assignment_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  basis          String          @db.VarChar(10)
  minutes        Int?
  amountTiyn     Int             @map("amount_tiyn")
  /// due → (owner pays through BuildPath) checkout → held → paid_out; or paid_direct; cancelled; held → refunded (returned to the owner by staff)
  status         String          @default("due") @db.VarChar(12)
  stageVersion   Int?            @map("stage_version")
  paidAt         DateTime?       @map("paid_at") @db.Timestamptz(3)
  markedByUserId String?         @map("marked_by_user_id") @db.Uuid
