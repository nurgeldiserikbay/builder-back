generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReviewMode {
  site_only
  site_and_design
  design_only
}

enum ReviewStatus {
  draft
  queued
  discovering
  ready
  failed
  cancelled
}

enum ReviewLocale {
  en
  ru
  kk
}

enum ReviewPageStatus {
  discovered
  mapped
  capture_queued
  captured
  failed
  excluded
}

enum DesignSourceType {
  upload
  figma
}

enum DesignAssetStatus {
  pending
  scanning
  verified
  rejected
  failed
}

enum ReviewCaptureStatus {
  queued
  captured
  failed
}

enum ReviewFindingCategory {
  requirement
  design
  backend
  accessibility
  performance
  seo
  security
}

enum ReviewFindingSeverity {
  critical
  high
  medium
  low
  info
}

enum ReviewFindingStatus {
  open
  accepted
  dismissed
  fixed
  unknown
}

enum ReviewRequirementStatus {
  pending
  satisfied
  failed
  blocked
  unknown
}

enum ReviewConfidence {
  high
  medium
  low
}

enum ReviewJobType {
  discover_pages
  capture_page
  compare_page
  generate_report
  export_report
}

enum ReviewJobStatus {
  queued
  running
  succeeded
  partial
  failed
  cancelled
}

enum ReviewReportStatus {
  generating
  ready
  failed
}

enum AccountLocale {
  en
  ru
  kk
}

enum WorkspaceRole {
  owner
  admin
  operator
  auditor
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked
}

enum ProjectStartMode {
  build
  improve
  design_implementation
  analysis_only
}

enum ProjectStatus {
  draft
  active
  paused
  completed
  archived
  live
}

enum ProjectRole {
  owner
  manager
  contributor
  reviewer
  viewer
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                    @db.VarChar(254)
  emailNormalized          String                    @unique @map("email_normalized") @db.VarChar(254)
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  name                     String?                   @db.VarChar(120)
  locale                   AccountLocale             @default(en)
  emailVerifiedAt          DateTime?                 @map("email_verified_at") @db.Timestamptz(3)
  /// Set when the owner deletes the account. Data is kept for the retention period from PrivacySettings, then purged.
  deletionRequestedAt      DateTime?                 @map("deletion_requested_at") @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                 UserSession[]
  verificationTokens       EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  ownedWorkspaces          Workspace[]               @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]
  createdInvitations       WorkspaceInvitation[]     @relation("InvitationCreator")
  ownedProjects             Project[]                 @relation("ProjectOwner")
  projectMemberships        ProjectMember[]
  ownedReviewRuns           ReviewRun[]               @relation("ReviewRunOwner")
  authoredFindings          ReviewFinding[]           @relation("FindingAuthor")
  authoredRequirements      ReviewRequirement[]       @relation("RequirementAuthor")
  assignedFindings          ReviewFinding[]           @relation("FindingAssignee")
  authoredPageMappings      PageDesignMapping[]      @relation("MappingAuthor")
  idempotencyRecords        IdempotencyRecord[]
  figmaConnection           FigmaConnection?
  figmaOAuthStates          FigmaOAuthState[]
  authoredApiChecks         ReviewApiCheck[]      @relation("ApiCheckAuthor")
  externalIdentities        ExternalIdentity[]
  telegramLinkCodes         TelegramLinkCode[]
  stageAssignments          StageAssignment[]
  telegramChats             TelegramChatState[]
  accountPlan               AccountPlan?
  consents                  UserConsent[]

  @@index([createdAt], map: "users_created_idx")
  @@index([deletionRequestedAt], map: "users_deletion_requested_idx")
  @@map("users")
  gitAccounts        GitAccount[]
  oauthStates        OAuthState[]
  payoutDetails      PayoutDetails?
}

model UserSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "user_sessions_user_expires_idx")
  @@index([revokedAt], map: "user_sessions_revoked_idx")
  @@map("user_sessions")
}

model EmailVerificationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "email_verification_tokens_user_expires_idx")
  @@map("email_verification_tokens")
}

/// One-time link to set a new password; only the SHA-256 of the link token is stored.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "password_reset_tokens_user_expires_idx")
  @@map("password_reset_tokens")
}

model Workspace {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId  String           @map("owner_user_id") @db.Uuid
  name         String           @db.VarChar(120)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner        User             @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  projects     Project[]

  @@index([ownerUserId, createdAt(sort: Desc)], map: "workspaces_owner_created_idx")
  @@map("workspaces")
}

model WorkspaceMember {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         WorkspaceRole
  status       MembershipStatus @default(active)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "workspace_members_workspace_user_key")
  @@index([userId, status], map: "workspace_members_user_status_idx")
  @@index([workspaceId, role, status], map: "workspace_members_workspace_role_status_idx")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  emailNormalized    String        @map("email_normalized") @db.VarChar(254)
  role               WorkspaceRole
  tokenHash          String        @unique @map("token_hash") @db.Char(64)
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt         DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt          DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdByUserId    String        @map("created_by_user_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User          @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, emailNormalized, expiresAt], map: "workspace_invitations_workspace_email_expires_idx")
  @@map("workspace_invitations")
}

model Project {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  ownerUserId  String           @map("owner_user_id") @db.Uuid
  name         String           @db.VarChar(120)
  summary      String?          @db.VarChar(4000)
  startMode    ProjectStartMode @map("start_mode")
  status       ProjectStatus    @default(draft)
  locale       AccountLocale    @default(en)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User             @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  reviewRuns   ReviewRun[]
  projectType      String?          @map("project_type") @db.VarChar(40)
  routeVersion     String?          @map("route_version") @db.VarChar(20)
  startStageKey    String?          @map("start_stage_key") @db.VarChar(40)
  stages           ProjectStage[]
  stageVersions    StageArtifactVersion[]
  stageInstructions StageInstruction[]
  generationRuns   GenerationRun[]
  events           ProjectEvent[]
  publication      SitePublication?
  assignments      StageAssignment[]
  telegramChats    TelegramChatState[]
  images           ProjectImage[]
  leads            SiteLead[]
  bookings         Booking[]
  orders           StoreOrder[]
  masterAccesses   MasterAccess[]
  changeNotices    ChangeNotice[]
  choices          ProjectChoice[]
  repository       CodeRepository?

  @@index([workspaceId, status, createdAt(sort: Desc)], map: "projects_workspace_status_created_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "projects_owner_created_idx")
  @@map("projects")
  topUps            ProjectTopUp[]
  aiReservations    AiReservation[]
  /// Days the next stage has to answer a change notice (1–14).
  changeResponseDays Int            @default(3) @map("change_response_days")
}

model ProjectMember {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        ProjectRole
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "project_members_project_user_key")
  @@index([userId, status], map: "project_members_user_status_idx")
  @@index([projectId, role, status], map: "project_members_project_role_status_idx")
  @@map("project_members")
}

model IdempotencyRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  scope       String   @db.VarChar(120)
  key         String   @db.VarChar(128)
  requestHash String   @map("request_hash") @db.Char(64)
  resourceId  String   @map("resource_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key], map: "idempotency_records_user_scope_key")
  @@index([expiresAt], map: "idempotency_records_expires_idx")
  @@map("idempotency_records")
}

model ReviewRun {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  ownerUserId       String       @map("owner_user_id") @db.Uuid
  title             String       @db.VarChar(120)
  mode              ReviewMode
  status            ReviewStatus @default(draft)
  locale            ReviewLocale
  baseOrigin        String?      @map("base_origin") @db.VarChar(512)
  sourceSnapshotId  String?      @map("source_snapshot_id") @db.Uuid
  sourceSnapshot    Json?        @map("source_snapshot") @db.JsonB
  configuration     Json?        @db.JsonB
  startedAt         DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  pages             ReviewPage[]
  designSources     DesignSource[]
  jobs              ReviewJob[]
  findings          ReviewFinding[]
  requirements      ReviewRequirement[]
  reports           ReviewReport[]
  apiChecks         ReviewApiCheck[]
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner             User         @relation("ReviewRunOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)], map: "review_runs_project_created_idx")
  @@index([ownerUserId, createdAt(sort: Desc)], map: "review_runs_owner_created_idx")
  @@index([status, createdAt], map: "review_runs_status_created_idx")
  @@map("review_runs")
}

model ReviewPage {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId     String           @map("review_run_id") @db.Uuid
  route           String           @db.VarChar(2048)
  title           String?          @db.VarChar(200)
  discoveryDepth  Int              @default(0) @map("discovery_depth")
  status          ReviewPageStatus @default(discovered)
  discoveredAt    DateTime         @default(now()) @map("discovered_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviewRun       ReviewRun        @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  mapping         PageDesignMapping?
  captures        ReviewCapture[]
  findings        ReviewFinding[]
  requirements    ReviewRequirement[]
  apiChecks       ReviewApiCheck[]

  @@unique([reviewRunId, route], map: "review_pages_run_route_key")
  @@index([reviewRunId, status], map: "review_pages_run_status_idx")
  @@map("review_pages")
}

model DesignSource {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId      String           @map("review_run_id") @db.Uuid
  sourceType       DesignSourceType @map("source_type")
  fileName         String?          @map("file_name") @db.VarChar(255)
  mimeType         String?          @map("mime_type") @db.VarChar(128)
  sizeBytes        BigInt?          @map("size_bytes")
  sha256           String?          @db.Char(64)
  storageKey       String?          @map("storage_key") @db.VarChar(1024)
  version          String?          @db.VarChar(255)
  assetStatus      DesignAssetStatus @default(pending) @map("asset_status")
  figmaFileKey     String?          @map("figma_file_key") @db.VarChar(128)
  figmaNodeId      String?          @map("figma_node_id") @db.VarChar(128)
  metadata         Json?             @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviewRun        ReviewRun         @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  mappings         PageDesignMapping[]
  captures         ReviewCapture[]

  @@index([reviewRunId, sourceType, assetStatus], map: "design_sources_run_type_status_idx")
  @@map("design_sources")
}

model PageDesignMapping {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId              String       @unique @map("page_id") @db.Uuid
  designSourceId      String?      @map("design_source_id") @db.Uuid
  viewportWidth       Int          @map("viewport_width")
  viewportHeight      Int          @map("viewport_height")
  deviceScale         Decimal      @default(1) @map("device_scale") @db.Decimal(4, 2)
  stateRecipe         Json?        @map("state_recipe") @db.JsonB
  requirementIds      String[]     @default([]) @map("requirement_ids") @db.Uuid
  apiOperationIds     String[]     @default([]) @map("api_operation_ids")
  mappingAuthorUserId String       @map("mapping_author_user_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  page                ReviewPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  designSource        DesignSource? @relation(fields: [designSourceId], references: [id], onDelete: SetNull)
  mappingAuthor       User          @relation("MappingAuthor", fields: [mappingAuthorUserId], references: [id], onDelete: Restrict)

  @@index([designSourceId], map: "page_design_mappings_source_idx")
  @@map("page_design_mappings")
}

model ReviewCapture {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId           String              @map("page_id") @db.Uuid
  designSourceId   String?             @map("design_source_id") @db.Uuid
  status           ReviewCaptureStatus @default(queued)
  viewportWidth    Int                 @map("viewport_width")
  viewportHeight   Int                 @map("viewport_height")
  deviceScale      Decimal             @default(1) @map("device_scale") @db.Decimal(4, 2)
  assetStorageKey  String?             @map("asset_storage_key") @db.VarChar(1024)
  visualDiff       Json?               @map("visual_diff") @db.JsonB
  qualityAudit     Json?               @map("quality_audit") @db.JsonB
  aiAnalysis       Json?               @map("ai_analysis") @db.JsonB
  sha256           String?             @db.Char(64)
  browserProfile   String              @map("browser_profile") @db.VarChar(128)
  toolVersion      String?             @map("tool_version") @db.VarChar(128)
  safeErrorCode    String?             @map("safe_error_code") @db.VarChar(64)
  capturedAt       DateTime?           @map("captured_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  page             ReviewPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  designSource     DesignSource?       @relation(fields: [designSourceId], references: [id], onDelete: SetNull)
  requirementEvidence ReviewRequirement[]

  @@index([pageId, createdAt(sort: Desc)], map: "review_captures_page_created_idx")
  @@index([status, createdAt], map: "review_captures_status_created_idx")
  @@map("review_captures")
}

model ReviewJob {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId     String          @map("review_run_id") @db.Uuid
  jobType         ReviewJobType   @map("job_type")
  status          ReviewJobStatus @default(queued)
  idempotencyKey  String          @map("idempotency_key") @db.VarChar(128)
  correlationId   String          @map("correlation_id") @db.VarChar(128)
  attemptCount    Int             @default(0) @map("attempt_count")
  progressPercent Int             @default(0) @map("progress_percent")
  safeErrorCode   String?         @map("safe_error_code") @db.VarChar(64)
  result           Json?          @db.JsonB
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(3)
  reviewRun        ReviewRun      @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)

  @@unique([reviewRunId, idempotencyKey], map: "review_jobs_run_idempotency_key")
  @@index([status, createdAt], map: "review_jobs_status_created_idx")
  @@index([reviewRunId, createdAt(sort: Desc)], map: "review_jobs_run_created_idx")
  @@map("review_jobs")
}

model ReviewFinding {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId      String                 @map("review_run_id") @db.Uuid
  pageId           String?                @map("page_id") @db.Uuid
  category         ReviewFindingCategory
  severity         ReviewFindingSeverity
  status           ReviewFindingStatus    @default(open)
  confidence       ReviewConfidence
  summary          String                 @db.VarChar(500)
  explanation      String                 @db.Text
  evidence         Json                   @db.JsonB
  coordinates      Json?                  @db.JsonB
  authorUserId     String                 @map("author_user_id") @db.Uuid
  assignedUserId   String?                @map("assigned_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviewRun        ReviewRun              @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  page             ReviewPage?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  author            User                   @relation("FindingAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  assignee          User?                  @relation("FindingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([reviewRunId, status, severity], map: "review_findings_run_status_severity_idx")
  @@index([pageId, createdAt], map: "review_findings_page_created_idx")
  @@map("review_findings")
}

model ReviewRequirement {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId       String                   @map("review_run_id") @db.Uuid
  pageId            String?                  @map("page_id") @db.Uuid
  category          ReviewFindingCategory     @default(requirement)
  title             String                   @db.VarChar(500)
  details           String?                  @db.Text
  status            ReviewRequirementStatus  @default(pending)
  verificationNote  String?                  @map("verification_note") @db.VarChar(2000)
  evidenceCaptureId String?                  @map("evidence_capture_id") @db.Uuid
  authorUserId      String                   @map("author_user_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviewRun         ReviewRun               @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  page              ReviewPage?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  evidenceCapture   ReviewCapture?          @relation(fields: [evidenceCaptureId], references: [id], onDelete: SetNull)
  author            User                    @relation("RequirementAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  apiChecks         ReviewApiCheck[]

  @@index([reviewRunId, pageId, status], map: "review_requirements_run_page_status_idx")
  @@index([evidenceCaptureId], map: "review_requirements_capture_idx")
  @@map("review_requirements")
}

model ReviewReport {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRunId     String             @map("review_run_id") @db.Uuid
  version         Int
  status          ReviewReportStatus @default(generating)
  summary         Json               @db.JsonB
  limitations     Json               @db.JsonB
  exporterVersion String             @map("exporter_version") @db.VarChar(128)
  generatedAt     DateTime?          @map("generated_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
