  @@index([projectId, createdAt(sort: Desc)], map: "generation_runs_project_time_idx")
  /// Platform-wide average request size (estimates) reads recent successful requests.
  @@index([status, createdAt(sort: Desc)], map: "generation_runs_status_created_idx")
  @@index([projectId, requestedByUserId, createdAt(sort: Desc)], map: "generation_runs_project_user_created_idx")
  @@map("generation_runs")
}

