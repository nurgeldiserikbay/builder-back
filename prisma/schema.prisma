  @@unique([projectId, number], map: "store_orders_project_number_key")
  @@index([projectId, createdAt], map: "store_orders_project_created_idx")
  @@index([publicationId, createdAt], map: "store_orders_publication_created_idx")
  @@map("store_orders")
}
