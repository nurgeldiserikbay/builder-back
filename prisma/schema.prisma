  lastError        String?   @map("last_error") @db.VarChar(80)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("code_repositories")
}

/// Single-row customer prices for AI usage (id = 1), set in the admin console. Each request stores its own cost.
/// Money set aside for an AI request while it runs: the balance check and the hold happen under the project wallet lock,
/// so parallel requests cannot spend the same money. One active hold per project also means one AI request at a time.
/// A hold past expiresAt (a crashed request) no longer counts.
model AiReservation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  amountTiyn Int      @map("amount_tiyn")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt], map: "ai_reservations_project_expires_idx")
  @@map("ai_reservations")
}

model AiPricing {
  id                   Int      @id @default(1) @db.SmallInt
  inputPerMillionTiyn  Int      @map("input_per_million_tiyn")
  outputPerMillionTiyn Int      @map("output_per_million_tiyn")
  /// off: AI requests are only counted; prepaid: a project needs a positive balance (top-ups minus AI cost since prepaidSince).
  billingMode          String   @default("off") @map("billing_mode") @db.VarChar(10)
  prepaidSince         DateTime? @map("prepaid_since") @db.Timestamptz(3)
  minTopUpTiyn         Int      @default(100000) @map("min_top_up_tiyn")
  /// Share BuildPath keeps from specialist payments made through the platform, in basis points (100 = 1%).
  specialistFeeBp      Int      @default(0) @map("specialist_fee_bp")
  updatedByStaffId     String?  @map("updated_by_staff_id") @db.Uuid
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_pricing")
}

/// Time a specialist worked on a stage. Tracked entries are built by the server from activity on the stage; manual ones need the owner's approval.
model TimeEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId    String          @map("assignment_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  startedAt       DateTime        @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime        @map("ended_at") @db.Timestamptz(3)
