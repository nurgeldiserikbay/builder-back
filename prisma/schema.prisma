  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  provider  String   @db.VarChar(20)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "oauth_states_expires_idx")
  @@map("oauth_states")
}

/// Money the owner put on a project's balance through the payment provider. Paid only after a signed provider callback.
model ProjectTopUp {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  amountTiyn        Int       @map("amount_tiyn")
  provider          String    @db.VarChar(20)
  /// created | paid | failed | expired
  status            String    @default("created") @db.VarChar(10)
  providerPaymentId String?   @map("provider_payment_id") @db.VarChar(64)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(3)
  /// Returned to the payer so far; the unspent part of a top-up can be returned on request.
  refundedTiyn      Int       @default(0) @map("refunded_tiyn")
  /// requested | refunded | rejected — the latest refund request; a requested amount is not available for AI requests.
  refundStatus      String?   @map("refund_status") @db.VarChar(10)
  refundRequestedTiyn Int?    @map("refund_requested_tiyn")
  refundReason      String?   @map("refund_reason") @db.VarChar(300)
  refundRequestedAt DateTime? @map("refund_requested_at") @db.Timestamptz(3)
  refundDecidedAt   DateTime? @map("refund_decided_at") @db.Timestamptz(3)
  refundDecidedByStaffId String? @map("refund_decided_by_staff_id") @db.Uuid
  refundReference   String?   @map("refund_reference") @db.VarChar(100)
  refundNote        String?   @map("refund_note") @db.VarChar(300)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status], map: "project_top_ups_project_status_idx")
  @@index([refundStatus], map: "project_top_ups_refund_status_idx")
  @@map("project_top_ups")
}

/// Where a specialist receives payouts. The IBAN is encrypted (CODE_HOSTING_TOKEN_ENCRYPTION_KEY) and shown only to staff making a transfer.
